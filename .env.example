# Preencha pelo menos UMA chave (todas gratuitas, sem cartão).
# Sem nenhuma chave o app roda em Modo Demo (respostas simuladas).
# Ordem de fallback: Groq -> OpenRouter -> Gemini (no Modo Pro, Gemini vem primeiro)
#
# Cada variável aceita VÁRIAS chaves separadas por vírgula. O servidor alterna
# entre elas (round-robin) e, se uma bater o limite (429), tenta a próxima.
# Ex.: GROQ_API_KEY=gsk_chave1,gsk_chave2

# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys (usa apenas modelos :free)
OPENROUTER_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Porta do servidor local
PORT=3000

# Modelo preferido (os outros entram como fallback automático)
DEFAULT_MODEL=openai/gpt-oss-120b

# Tempo máximo (ms) esperando um provedor antes de pular para o próximo
UPSTREAM_TIMEOUT_MS=25000

# Limite de requisições por minuto, por IP, em /api/chat, /api/chat/stream e /api/summarize
RATE_LIMIT_PER_MIN=30

# Origens permitidas (CORS), separadas por vírgula. Vazio = qualquer origem (dev local).
# Em produção, ex.: ALLOWED_ORIGINS=https://meu-app.vercel.app,https://localhost
# (https://localhost é a origem do app Android via Capacitor)
ALLOWED_ORIGINS=

# Atrás de proxy/CDN (Vercel, Render, Nginx), ative para o rate limit ver o IP real
# do usuário em vez do IP do proxy. Use "true" ou o número de proxies (ex.: 1).
TRUST_PROXY=
